# Regras de keep do MotorLog (o AGP combina todos os arquivos desta pasta e passa ao R8).
# Room, WorkManager e Compose já trazem as próprias regras nas bibliotecas.

# Entidades do Room são data classes lidas pelo código gerado — sem reflexão, mas manter os nomes
# das colunas evita surpresa se algum dia entrar TypeConverter/consulta por nome.
-keep class com.development.motorlog.data.** { *; }

# Receiver/Worker são instanciados pelo sistema pelo nome
-keep class com.development.motorlog.lembrete.** { *; }

# rastro legível em crash (o mapping.txt vai pro Play Console)
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
