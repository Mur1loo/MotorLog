<?xml version="1.0" encoding="utf-8"?><!--
   Backup do Android 12+ (API 31+). Ver https://developer.android.com/about/versions/12/backup-restore
   O backup na nuvem do Google tem teto de 25 MB por app: se passar, NADA é salvo — nem o banco.
   Por isso as fotos do álbum (filesDir/fotos, ~300-600 KB cada) ficam de fora da nuvem e o banco
   (motos, trocas, serviços, km) sempre cabe. Na restauração, foto sem arquivo mostra só o fundo.
   A transferência direta entre celulares (cabo/Wi-Fi na configuração do aparelho novo) não tem
   esse teto: sem <device-transfer> aqui, ela leva tudo, fotos inclusive.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="fotos/" />
    </cloud-backup>
</data-extraction-rules>
