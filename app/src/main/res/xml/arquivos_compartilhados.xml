<?xml version="1.0" encoding="utf-8"?>
<!-- Pastas que o FileProvider pode expor (sempre temporárias, no cache):
     camera/ = onde o app da câmera grava a foto antes de ela entrar no álbum;
     relatorios/ = o PDF do histórico, na hora de compartilhar; cartoes/ = as imagens pra compartilhar
     (marco, ficha da moto, antes e depois); album/ = cópia das fotos mandadas pro novo dono na
     despedida. O álbum em si (filesDir/fotos) NÃO sai daqui. -->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="relatorios" path="relatorios/" />
    <cache-path name="cartoes" path="cartoes/" />
    <cache-path name="album" path="album/" />
</paths>
